# Example only: Django does not load this file automatically.
DJANGO_SETTINGS_MODULE=config.settings.production
PROGRAM_DEBUG=0
PROGRAM_SECRET_KEY='replace-with-a-random-secret-of-at-least-50-characters'
PROGRAM_ALLOWED_HOSTS=program.example.com
PROGRAM_DB_ENGINE=postgresql
PROGRAM_DB_NAME=program_org
PROGRAM_DB_USER=program_org
PROGRAM_DB_PASSWORD='replace-with-database-password'
PROGRAM_DB_HOST=127.0.0.1
PROGRAM_DB_PORT=5432
# For a remote TLS-enabled database:
# PROGRAM_DB_SSLMODE=verify-full
# PROGRAM_DB_SSLROOTCERT=/path/to/root.crt

PROGRAM_CSRF_TRUSTED_ORIGINS=https://program.example.com
# Enable only when the trusted proxy overwrites X-Forwarded-Proto:
# PROGRAM_TRUST_PROXY_SSL_HEADER=1
# PROGRAM_STATIC_ROOT=/opt/program_org/shared/staticfiles
# PROGRAM_MEDIA_ROOT=/opt/program_org/shared/media
