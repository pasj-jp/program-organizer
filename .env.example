# Example only: Django does not load this file automatically.
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_DEBUG=0
DJANGO_SECRET_KEY='replace-with-a-random-secret-of-at-least-50-characters'
DJANGO_ALLOWED_HOSTS=program.example.com
DJANGO_DB_ENGINE=postgresql
DJANGO_DB_NAME=program_org
DJANGO_DB_USER=program_org
DJANGO_DB_PASSWORD='replace-with-database-password'
DJANGO_DB_HOST=127.0.0.1
DJANGO_DB_PORT=5432
# For a remote TLS-enabled database:
# DJANGO_DB_SSLMODE=verify-full
# DJANGO_DB_SSLROOTCERT=/path/to/root.crt

DJANGO_CSRF_TRUSTED_ORIGINS=https://program.example.com
# Enable only when the trusted proxy overwrites X-Forwarded-Proto:
# DJANGO_TRUST_PROXY_SSL_HEADER=1
# DJANGO_STATIC_ROOT=/opt/program_org/shared/staticfiles
# DJANGO_MEDIA_ROOT=/opt/program_org/shared/media
